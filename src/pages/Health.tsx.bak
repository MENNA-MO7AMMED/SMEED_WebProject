import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { 
  Heart, 
  Activity, 
  User, 
  Calculator, 
  Droplet, 
  Calendar,
  TrendingUp,
  FileText,
  Download,
  Edit,
  Save,
  Target,
  Dumbbell,
  Scale,
  Clock,
  BarChart3,
  Play,
  CheckCircle,
  AlertCircle,
  Info
} from 'lucide-react';
import Button from '../components/ui/Button';
import Card from '../components/ui/Card';
import Input from '../components/ui/Input';
import Header from '../components/layout/Header';
import Footer from '../components/layout/Footer';
import { useAuth } from '../contexts/AuthContext';
import { initParticleEffect } from '../utils/animations';
import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';
import { 
  HealthProfile, 
  HealthFormData, 
  BMIResult, 
  WaterIntakeRecommendation, 
  ExerciseRecommendation,
  HealthData
} from '../types/health';

const Health: React.FC = () => {
  const navigate = useNavigate();
  const { currentUser, isAuthenticated } = useAuth();
  const [healthProfile, setHealthProfile] = useState<HealthProfile | null>(null);
  const [isFirstTime, setIsFirstTime] = useState(true);
  const [isEditing, setIsEditing] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [activeTab, setActiveTab] = useState<'dashboard' | 'profile' | 'plans' | 'reports'>('plans');
  const [selectedPlan, setSelectedPlan] = useState<string | null>(null);
  const [planProgress, setPlanProgress] = useState<{[key: string]: number}>({});
  const [showLoginReminder, setShowLoginReminder] = useState(false);
  
  // Student-specific identifiers
  const studentId = currentUser?.id ? parseInt(currentUser.id) : null;
  const studentHealthKey = studentId ? `health_profile_${studentId}` : null;
  const studentProgressKey = studentId ? `plan_progress_${studentId}` : null;
  const studentDataKey = studentId ? `health_data_${studentId}` : null;
  
  const [formData, setFormData] = useState<HealthFormData>({
    height: '',
    weight: '',
    gender: 'male',
    blood_type: '',
    chronic_diseases: '',
    allergies: '',
    fitness_goal: 'general_health',
    target_weight: '',
    activity_level: 'moderate',
    dietary_preferences: ''
  });

  const [errors, setErrors] = useState<Partial<HealthFormData>>({});
  const [todayData, setTodayData] = useState<HealthData>({
    health_id: studentId || 0,
    record_date: new Date(),
    steps: 0,
    calories_burned: 0,
    sleep_hours: 0,
    water_intake: 0,
    heart_rate: 0,
    mood: 'average'
  });

  // Initialize particle effect and cleanup
  useEffect(() => {
    // Initialize particle effect
    const canvas = document.createElement('canvas');
    canvas.id = 'health-particles-canvas';
    document.body.appendChild(canvas);
    
    initParticleEffect('health-particles-canvas');
    
    return () => {
      // Clean up
      const canvasElement = document.getElementById('health-particles-canvas');
      if (canvasElement) {
        canvasElement.remove();
      }
    };
  }, []);

  // Student-specific data loading
  useEffect(() => {
    if (isAuthenticated && currentUser && studentId && studentHealthKey) {
      // Load student's health profile
      const hasProfile = localStorage.getItem(studentHealthKey);
      if (hasProfile) {
        try {
          const profile = JSON.parse(hasProfile);
          // Verify the profile belongs to this student
          if (profile.student_id === studentId) {
            setHealthProfile(profile);
            setIsFirstTime(false);
          } else {
            // Data integrity issue - remove invalid data
            localStorage.removeItem(studentHealthKey);
            setIsFirstTime(true);
          }
        } catch (error) {
          console.error('Error parsing health profile:', error);
          localStorage.removeItem(studentHealthKey);
          setIsFirstTime(true);
        }
      } else {
        setIsFirstTime(true);
      }
      
      // Load student's plan progress
      if (studentProgressKey) {
        const savedProgress = localStorage.getItem(studentProgressKey);
        if (savedProgress) {
          try {
            setPlanProgress(JSON.parse(savedProgress));
          } catch (error) {
            console.error('Error parsing plan progress:', error);
            localStorage.removeItem(studentProgressKey);
          }
        }
      }
      
      // Load student's daily health data
      if (studentDataKey) {
        const savedData = localStorage.getItem(studentDataKey);
        if (savedData) {
          try {
            const data = JSON.parse(savedData);
            setTodayData({ ...data, health_id: studentId });
          } catch (error) {
            console.error('Error parsing health data:', error);
            localStorage.removeItem(studentDataKey);
          }
        }
      }
    } else if (!isAuthenticated) {
      // Clear all data when user logs out
      setHealthProfile(null);
      setPlanProgress({});
      setIsFirstTime(true);
      setSelectedPlan(null);
      
      // Show login reminder for guest users
      setTimeout(() => {
        setShowLoginReminder(true);
      }, 3000);
    }
  }, [currentUser, isAuthenticated, studentId, studentHealthKey, studentProgressKey, studentDataKey]);

  // Student verification helper
  const verifyStudentAccess = (): boolean => {
    if (!isAuthenticated || !currentUser || !studentId) {
      alert('Please login to access health features!');
      return false;
    }
    return true;
  };

  // Health Plans Data (same for all students but progress is individual)
  const healthPlans = [
    {
      id: 'weight_loss',
      title: 'Weight Loss Plan',
      description: 'Structured program to help you lose weight safely and sustainably',
      icon: <TrendingUp className="h-8 w-8 text-red-500" />,
      color: 'red',
      duration: '12 weeks',
      difficulty: 'Intermediate',
      features: ['Calorie deficit diet', 'Cardio exercises', 'Progress tracking', 'Weekly check-ins'],
      dailyActivities: [
        'Morning cardio (30 minutes)',
        'Healthy breakfast (350 calories)',
        'Lunch (400 calories)', 
        'Afternoon walk (15 minutes)',
        'Dinner (300 calories)',
        'Evening stretching (10 minutes)'
      ],
      weeklyGoals: [
        'Lose 0.5-1 kg per week',
        '150 minutes of cardio',
        'Drink 2.5L water daily',
        'Track all meals'
      ]
    },
    {
      id: 'muscle_gain',
      title: 'Muscle Gain Plan',
      description: 'Build lean muscle mass with targeted workouts and nutrition',
      icon: <Dumbbell className="h-8 w-8 text-blue-500" />,
      color: 'blue',
      duration: '16 weeks',
      difficulty: 'Advanced',
      features: ['Strength training', 'Protein-rich diet', 'Progressive overload', 'Recovery planning'],
      dailyActivities: [
        'Strength training (45-60 minutes)',
        'Protein shake post-workout',
        'High-protein meals (2000+ calories)',
        'Rest between sets',
        'Adequate sleep (8+ hours)',
        'Hydration tracking'
      ],
      weeklyGoals: [
        'Gain 0.25-0.5 kg per week',
        '4-5 strength sessions',
        '150g+ protein daily',
        'Progressive weight increase'
      ]
    },
    {
      id: 'maintenance',
      title: 'Weight Maintenance',
      description: 'Maintain your current weight while improving overall fitness',
      icon: <Scale className="h-8 w-8 text-green-500" />,
      color: 'green',
      duration: 'Ongoing',
      difficulty: 'Beginner',
      features: ['Balanced nutrition', 'Regular exercise', 'Lifestyle habits', 'Health monitoring'],
      dailyActivities: [
        'Balanced meals (maintenance calories)',
        'Mixed exercise (30 minutes)',
        'Daily movement tracking',
        'Stress management',
        'Quality sleep',
        'Mindful eating'
      ],
      weeklyGoals: [
        'Maintain stable weight',
        '150 minutes moderate activity',
        'Consistent meal timing',
        'Regular health checks'
      ]
    },
    {
      id: 'bulking',
      title: 'Bulking Program',
      description: 'Gain weight and muscle mass systematically and healthily',
      icon: <TrendingUp className="h-8 w-8 text-purple-500" />,
      color: 'purple',
      duration: '20 weeks',
      difficulty: 'Advanced',
      features: ['Calorie surplus', 'Heavy lifting', 'Mass building', 'Nutrient timing'],
      dailyActivities: [
        'Heavy compound exercises',
        'High-calorie meals (2500+ calories)',
        'Pre/post workout nutrition',
        'Progressive overload tracking',
        'Recovery optimization',
        'Supplement timing'
      ],
      weeklyGoals: [
        'Gain 0.5-1 kg per week',
        'Increase lifting weights',
        'Consistent calorie surplus',
        'Track body composition'
      ]
    },
    {
      id: 'wellness',
      title: 'General Wellness',
      description: 'Overall health improvement and disease prevention',
      icon: <Heart className="h-8 w-8 text-pink-500" />,
      color: 'pink',
      duration: 'Lifestyle',
      difficulty: 'Beginner',
      features: ['Balanced lifestyle', 'Preventive care', 'Stress management', 'Regular check-ups'],
      dailyActivities: [
        'Moderate exercise (30 minutes)',
        'Mindfulness practice (10 minutes)',
        'Nutritious meals',
        'Adequate hydration',
        'Quality sleep routine',
        'Stress reduction activities'
      ],
      weeklyGoals: [
        'Maintain energy levels',
        'Practice stress management',
        'Regular health monitoring',
        'Consistent healthy habits'
      ]
    },
    {
      id: 'custom',
      title: 'Custom Plan',
      description: 'Personalized plan based on your specific needs and preferences',
      icon: <Target className="h-8 w-8 text-indigo-500" />,
      color: 'indigo',
      duration: 'Flexible',
      difficulty: 'Variable',
      features: ['Tailored approach', 'Flexible schedule', 'Personal goals', 'Adaptive planning'],
      dailyActivities: [
        'Customized workout routine',
        'Personalized meal plan',
        'Goal-specific activities',
        'Flexible timing',
        'Progress adaptation',
        'Personal preferences'
      ],
      weeklyGoals: [
        'Meet personal objectives',
        'Adapt plan as needed',
        'Track custom metrics',
        'Maintain motivation'
      ]
    }
  ];

  // BMI Calculation - Personalized for the student
  const calculateBMI = (height: number, weight: number): BMIResult => {
    const heightInMeters = height / 100;
    const bmi = weight / (heightInMeters * heightInMeters);
    
    let category: BMIResult['category'];
    let description: string;
    
    if (bmi < 18.5) {
      category = 'underweight';
      description = 'You are underweight. Consider consulting a nutritionist for a personalized weight gain plan.';
    } else if (bmi < 25) {
      category = 'normal';
      description = 'You have a healthy weight! Keep maintaining your current lifestyle and healthy habits.';
    } else if (bmi < 30) {
      category = 'overweight';
      description = 'You are overweight. Consider our Weight Loss Plan and consult with a healthcare professional.';
    } else {
      category = 'obese';
      description = 'You are obese. Please consult a healthcare professional for a comprehensive weight management plan.';
    }
    
    return { bmi: parseFloat(bmi.toFixed(1)), category, description };
  };

  // Water Intake Calculation - Personalized for the student
  const calculateWaterIntake = (weight: number, activityLevel: string, age: number): WaterIntakeRecommendation => {
    let baseIntake = weight * 0.033; // Basic formula: 33ml per kg
    
    const activityMultipliers = {
      sedentary: 1,
      light: 1.1,
      moderate: 1.2,
      active: 1.3,
      very_active: 1.4
    };
    
    const multiplier = activityMultipliers[activityLevel as keyof typeof activityMultipliers];
    let totalIntake = baseIntake * multiplier;
    
    // Age adjustment
    if (age > 65) totalIntake *= 1.1;
    
    const factors = [
      `Based on your body weight (${weight} kg)`,
      `Your activity level: ${activityLevel.replace('_', ' ')}`,
      age > 65 ? 'Age adjustment applied (65+)' : '',
      'Climate and health conditions may require adjustment'
    ].filter(Boolean);
    
    return {
      daily_liters: parseFloat(totalIntake.toFixed(1)),
      glasses: Math.ceil(totalIntake * 4), // Assuming 250ml glasses
      factors
    };
  };

  // Exercise Recommendation - Personalized for the student
  const calculateExerciseRecommendation = (fitnessGoal: string, activityLevel: string): ExerciseRecommendation => {
    const recommendations = {
      weight_loss: {
        weekly_hours: 5,
        daily_minutes: 45,
        activity_suggestions: ['Cardio exercises', 'HIIT training', 'Swimming', 'Cycling', 'Brisk walking'],
        intensity: 'Moderate to High'
      },
      muscle_gain: {
        weekly_hours: 4,
        daily_minutes: 60,
        activity_suggestions: ['Weight training', 'Resistance exercises', 'Compound movements', 'Progressive overload'],
        intensity: 'High'
      },
      general_health: {
        weekly_hours: 3,
        daily_minutes: 30,
        activity_suggestions: ['Walking', 'Light jogging', 'Yoga', 'Stretching', 'Recreational sports'],
        intensity: 'Moderate'
      },
      custom: {
        weekly_hours: 3,
        daily_minutes: 30,
        activity_suggestions: ['Customized based on your personal preferences and goals'],
        intensity: 'Variable'
      }
    };
    
    return recommendations[fitnessGoal as keyof typeof recommendations] || recommendations.general_health;
  };

  const validateForm = (): boolean => {
    const newErrors: Partial<HealthFormData> = {};
    
    if (!formData.height || parseFloat(formData.height) < 100 || parseFloat(formData.height) > 250) {
      newErrors.height = 'Height must be between 100-250 cm';
    }
    
    if (!formData.weight || parseFloat(formData.weight) < 30 || parseFloat(formData.weight) > 300) {
      newErrors.weight = 'Weight must be between 30-300 kg';
    }
    
    if (!formData.blood_type) {
      newErrors.blood_type = 'Blood type is required';
    }
    
    if (!formData.target_weight || parseFloat(formData.target_weight) < 30 || parseFloat(formData.target_weight) > 300) {
      newErrors.target_weight = 'Target weight must be between 30-300 kg';
    }
    
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    
    if (!verifyStudentAccess() || !studentId || !studentHealthKey) return;
    
    if (!validateForm()) return;
    
    setIsLoading(true);
    
    try {
      // Simulate API call
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      const newProfile: HealthProfile = {
        health_id: isFirstTime ? undefined : healthProfile?.health_id,
        student_id: studentId, // Ensure student ID is always set
        height: parseFloat(formData.height),
        weight: parseFloat(formData.weight),
        gender: formData.gender,
        blood_type: formData.blood_type,
        chronic_diseases: formData.chronic_diseases || 'None',
        allergies: formData.allergies || 'None',
        fitness_goal: formData.fitness_goal,
        target_weight: parseFloat(formData.target_weight),
        activity_level: formData.activity_level,
        dietary_preferences: formData.dietary_preferences || 'Not specified',
        created_at: isFirstTime ? new Date() : healthProfile?.created_at,
        updated_at: new Date()
      };
      
      setHealthProfile(newProfile);
      localStorage.setItem(studentHealthKey, JSON.stringify(newProfile));
      
      if (isFirstTime) {
        setIsFirstTime(false);
        setActiveTab('dashboard');
      } else {
        setIsEditing(false);
      }
      
      // Success message with student identification
      alert(`Health profile ${isFirstTime ? 'created' : 'updated'} successfully for ${currentUser?.firstName || 'Student'} ${currentUser?.lastName || ''}!`);
      
    } catch (error) {
      console.error('Error saving health profile:', error);
      alert('Error saving health profile. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  const handleEdit = () => {
    if (!verifyStudentAccess()) return;
    
    if (healthProfile) {
      setFormData({
        height: healthProfile.height.toString(),
        weight: healthProfile.weight.toString(),
        gender: healthProfile.gender,
        blood_type: healthProfile.blood_type,
        chronic_diseases: healthProfile.chronic_diseases,
        allergies: healthProfile.allergies,
        fitness_goal: healthProfile.fitness_goal,
        target_weight: healthProfile.target_weight.toString(),
        activity_level: healthProfile.activity_level,
        dietary_preferences: healthProfile.dietary_preferences
      });
      setIsEditing(true);
    }
  };

  const handleStartPlan = (planId: string) => {
    if (!verifyStudentAccess() || !studentProgressKey) {
      setShowLoginReminder(true);
      setTimeout(() => setShowLoginReminder(false), 5000);
      return;
    }
    
    setSelectedPlan(planId);
    const newProgress = { ...planProgress };
    if (!newProgress[planId]) {
      newProgress[planId] = 0;
    }
    setPlanProgress(newProgress);
    localStorage.setItem(studentProgressKey, JSON.stringify(newProgress));
    
    // Show success message with student identification
    const planTitle = healthPlans.find(p => p.id === planId)?.title;
    alert(`${planTitle} started successfully for ${currentUser?.firstName}! Check your dashboard for daily activities.`);
  };

  const updatePlanProgress = (planId: string, progress: number) => {
    if (!verifyStudentAccess() || !studentProgressKey) return;
    
    const newProgress = { ...planProgress, [planId]: progress };
    setPlanProgress(newProgress);
    localStorage.setItem(studentProgressKey, JSON.stringify(newProgress));
    
    // Update health data timestamp
    if (studentDataKey) {
      const updatedData = { ...todayData, updated_at: new Date() };
      setTodayData(updatedData);
      localStorage.setItem(studentDataKey, JSON.stringify(updatedData));
    }
  };

  // PDF Generation Function - Student-specific
  const generateHealthPDF = (type: 'daily' | 'weekly' | 'monthly' | 'yearly') => {
    if (!currentUser || !healthProfile) {
      throw new Error('Missing student or health profile data');
    }
    
    const doc = new jsPDF();
    const pageWidth = doc.internal.pageSize.width;
    const pageHeight = doc.internal.pageSize.height;
    
    // Colors - properly typed as tuples
    const primaryColor: [number, number, number] = [59, 130, 246]; // Blue
    const secondaryColor: [number, number, number] = [16, 185, 129]; // Green
    const textColor: [number, number, number] = [55, 65, 81]; // Gray
    
    // Header with student identification
    doc.setFillColor(primaryColor[0], primaryColor[1], primaryColor[2]);
    doc.rect(0, 0, pageWidth, 40, 'F');
    
    // Logo area
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(24);
    doc.setFont('helvetica', 'bold');
    doc.text('SMEED Health Dashboard', 20, 25);
    
    // Report title
    doc.setFontSize(16);
    doc.setFont('helvetica', 'normal');
    doc.text(`${type.charAt(0).toUpperCase() + type.slice(1)} Health Report`, pageWidth - 20, 25, { align: 'right' });
    
    // Reset text color
    doc.setTextColor(textColor[0], textColor[1], textColor[2]);
    
    // Student Information Section
    let yPos = 60;
    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text('Student Information', 20, yPos);
    
    yPos += 15;
    doc.setFontSize(12);
    doc.setFont('helvetica', 'normal');
    
    const studentInfo = [
      ['Student ID', studentId?.toString() || 'N/A'],
      ['Student Name', `${currentUser?.firstName || 'Unknown'} ${currentUser?.lastName || 'Student'}`],
      ['Email', currentUser?.email || 'N/A'],
      ['Report Date', new Date().toLocaleDateString()],
      ['Report Type', type.charAt(0).toUpperCase() + type.slice(1)],
      ['Profile Created', healthProfile.created_at ? new Date(healthProfile.created_at).toLocaleDateString() : 'N/A'],
      ['Last Updated', healthProfile.updated_at ? new Date(healthProfile.updated_at).toLocaleDateString() : 'N/A'],
    ];
    
    studentInfo.forEach(([label, value]) => {
      doc.setFont('helvetica', 'bold');
      doc.text(`${label}:`, 20, yPos);
      doc.setFont('helvetica', 'normal');
      doc.text(value, 80, yPos);
      yPos += 8;
    });
    
    // Health Profile Section
    yPos += 10;
    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text(`Health Profile - Student ID: ${studentId}`, 20, yPos);
    
    yPos += 15;
    
    // Create health profile table
    const healthData = [
      ['Height', `${healthProfile.height} cm`],
      ['Weight', `${healthProfile.weight} kg`],
      ['Gender', healthProfile.gender.charAt(0).toUpperCase() + healthProfile.gender.slice(1)],
      ['Blood Type', healthProfile.blood_type],
      ['Fitness Goal', healthProfile.fitness_goal.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase())],
      ['Target Weight', `${healthProfile.target_weight} kg`],
      ['Activity Level', healthProfile.activity_level.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase())],
      ['Dietary Preferences', healthProfile.dietary_preferences],
      ['Chronic Diseases', healthProfile.chronic_diseases],
      ['Allergies', healthProfile.allergies],
    ];
    
    autoTable(doc, {
      startY: yPos,
      head: [['Health Attribute', 'Value']],
      body: healthData,
      theme: 'grid',
      headStyles: { fillColor: primaryColor, textColor: [255, 255, 255] },
      styles: { fontSize: 10 },
      columnStyles: {
        0: { fontStyle: 'bold', cellWidth: 60 },
        1: { cellWidth: 80 }
      }
    });
    
    yPos = (doc as any).lastAutoTable.finalY + 20;
    
    // BMI Analysis Section - Student-specific
    const bmiResult = calculateBMI(healthProfile.height, healthProfile.weight);
    
    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text(`BMI Analysis for ${currentUser?.firstName || 'Student'}`, 20, yPos);
    
    yPos += 15;
    
    // BMI colored box
    const bmiColor: [number, number, number] = bmiResult.category === 'normal' ? [16, 185, 129] : 
                    bmiResult.category === 'overweight' ? [245, 158, 11] : [239, 68, 68];
    
    doc.setFillColor(bmiColor[0], bmiColor[1], bmiColor[2]);
    doc.roundedRect(20, yPos - 10, 60, 20, 3, 3, 'F');
    
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(16);
    doc.setFont('helvetica', 'bold');
    doc.text(`BMI: ${bmiResult.bmi}`, 50, yPos, { align: 'center' });
    
    doc.setTextColor(textColor[0], textColor[1], textColor[2]);
    doc.setFontSize(14);
    doc.text(`Category: ${bmiResult.category.toUpperCase()}`, 90, yPos - 5);
    
    yPos += 15;
    doc.setFontSize(10);
    doc.setFont('helvetica', 'normal');
    const splitDescription = doc.splitTextToSize(bmiResult.description, pageWidth - 40);
    doc.text(splitDescription, 20, yPos);
    yPos += splitDescription.length * 5 + 10;
    
    // Personalized Recommendations Section
    const age = currentUser?.birthDate ? new Date().getFullYear() - new Date(currentUser.birthDate).getFullYear() : 25;
    const waterRecommendation = calculateWaterIntake(healthProfile.weight, healthProfile.activity_level, age);
    const exerciseRecommendation = calculateExerciseRecommendation(healthProfile.fitness_goal, healthProfile.activity_level);
    
    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text(`Personalized Recommendations for ${currentUser?.firstName || 'Student'}`, 20, yPos);
    
    yPos += 15;
    
    const recommendationsData = [
      ['Daily Water Intake', `${waterRecommendation.daily_liters}L (${waterRecommendation.glasses} glasses)`],
      ['Daily Exercise Time', `${exerciseRecommendation.daily_minutes} minutes`],
      ['Exercise Intensity', exerciseRecommendation.intensity],
      ['Weekly Exercise Hours', `${exerciseRecommendation.weekly_hours} hours`],
      ['Recommended Activities', exerciseRecommendation.activity_suggestions.join(', ')],
    ];
    
    autoTable(doc, {
      startY: yPos,
      head: [['Recommendation Type', 'Personalized Target']],
      body: recommendationsData,
      theme: 'grid',
      headStyles: { fillColor: secondaryColor, textColor: [255, 255, 255] },
      styles: { fontSize: 10 },
      columnStyles: {
        0: { fontStyle: 'bold', cellWidth: 60 },
        1: { cellWidth: 80 }
      }
    });
    
    yPos = (doc as any).lastAutoTable.finalY + 20;
    
    // Active Plans Section - Student-specific
    const activePlans = Object.entries(planProgress).filter(([_, progress]) => progress > 0);
    
    if (activePlans.length > 0) {
      // Check if we need a new page
      if (yPos > pageHeight - 60) {
        doc.addPage();
        yPos = 20;
      }
      
      doc.setFontSize(18);
      doc.setFont('helvetica', 'bold');
      doc.text(`Active Health Plans - Student ID: ${studentId}`, 20, yPos);
      
      yPos += 15;
      
      const plansData = activePlans.map(([planId, progress]) => {
        const plan = healthPlans.find(p => p.id === planId);
        return [
          plan?.title || planId,
          `${progress}%`,
          plan?.duration || 'N/A',
          plan?.difficulty || 'N/A'
        ];
      });
      
      autoTable(doc, {
        startY: yPos,
        head: [['Plan Name', 'Progress', 'Duration', 'Difficulty']],
        body: plansData,
        theme: 'grid',
        headStyles: { fillColor: primaryColor, textColor: [255, 255, 255] },
        styles: { fontSize: 10 },
      });
      
      yPos = (doc as any).lastAutoTable.finalY + 20;
    }
    
    // Health Goals Progress - Student-specific
    // Check if we need a new page
    if (yPos > pageHeight - 60) {
      doc.addPage();
      yPos = 20;
    }
    
    doc.setFontSize(18);
    doc.setFont('helvetica', 'bold');
    doc.text(`Goal Progress - ${currentUser?.firstName || 'Student'} ${currentUser?.lastName || ''}`, 20, yPos);
    
    yPos += 15;
    
    const weightDifference = Math.abs(healthProfile.weight - healthProfile.target_weight);
    const progressPercentage = Math.max(0, Math.min(100, (1 - weightDifference / Math.max(healthProfile.weight, healthProfile.target_weight)) * 100));
    
    doc.setFontSize(12);
    doc.setFont('helvetica', 'normal');
    doc.text(`Current Weight: ${healthProfile.weight} kg`, 20, yPos);
    doc.text(`Target Weight: ${healthProfile.target_weight} kg`, 20, yPos + 8);
    doc.text(`Weight Goal Progress: ${progressPercentage.toFixed(1)}%`, 20, yPos + 16);
    doc.text(`Weight Difference: ${weightDifference.toFixed(1)} kg`, 20, yPos + 24);
    
    // Progress bar
    doc.setDrawColor(200, 200, 200);
    doc.rect(20, yPos + 35, 100, 8);
    doc.setFillColor(secondaryColor[0], secondaryColor[1], secondaryColor[2]);
    doc.rect(20, yPos + 35, (progressPercentage / 100) * 100, 8, 'F');
    
    // Footer with student identification
    const footerY = pageHeight - 20;
    doc.setFontSize(8);
    doc.setTextColor(128, 128, 128);
    doc.text(`Generated for Student ID: ${studentId} | SMEED Health Dashboard`, 20, footerY);
    doc.text(`Page 1`, pageWidth - 20, footerY, { align: 'right' });
    doc.text(new Date().toISOString(), pageWidth / 2, footerY, { align: 'center' });
    
    return doc;
  };

  const generateReport = async (type: 'daily' | 'weekly' | 'monthly' | 'yearly', format: 'pdf' | 'excel') => {
    if (!verifyStudentAccess() || !healthProfile) {
      alert('Please complete your health profile first to generate reports!');
      return;
    }
    
    setIsLoading(true);
    
    try {
      // Simulate report generation delay
      await new Promise(resolve => setTimeout(resolve, 1500));
      
      if (format === 'pdf') {
        // Generate PDF
        const doc = generateHealthPDF(type);
        
        // Download the PDF with student identification
        const fileName = `health_report_${type}_student_${studentId}_${new Date().toISOString().split('T')[0]}.pdf`;
        doc.save(fileName);
        
      } else if (format === 'excel') {
        // For Excel, create a CSV file with student data
        let csvContent = `Health Report - Student ID: ${studentId}\n`;
        csvContent += `Student Name: ${currentUser?.firstName} ${currentUser?.lastName}\n`;
        csvContent += `Report Type: ${type}\n`;
        csvContent += `Generated Date: ${new Date().toLocaleDateString()}\n\n`;
        
        csvContent += "Health Profile Data\n";
        csvContent += `Student ID,${studentId}\n`;
        csvContent += `Height,${healthProfile.height} cm\n`;
        csvContent += `Weight,${healthProfile.weight} kg\n`;
        csvContent += `Gender,${healthProfile.gender}\n`;
        csvContent += `Blood Type,${healthProfile.blood_type}\n`;
        csvContent += `BMI,${calculateBMI(healthProfile.height, healthProfile.weight).bmi}\n`;
        csvContent += `Target Weight,${healthProfile.target_weight} kg\n`;
        csvContent += `Fitness Goal,${healthProfile.fitness_goal}\n`;
        csvContent += `Activity Level,${healthProfile.activity_level}\n\n`;
        
        if (Object.keys(planProgress).length > 0) {
          csvContent += "Active Plans Progress\n";
          Object.entries(planProgress).forEach(([planId, progress]) => {
            const plan = healthPlans.find(p => p.id === planId);
            csvContent += `${plan?.title || planId},${progress}%\n`;
          });
        }
        
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `health_report_${type}_student_${studentId}_${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }
      
      // Success message with student identification
      alert(`${type.charAt(0).toUpperCase() + type.slice(1)} health report generated successfully for ${currentUser?.firstName} ${currentUser?.lastName}!`);
      
    } catch (error) {
      console.error('Error generating report:', error);
      alert('Error generating report. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  // Floating shapes for visual interest - similar to Home page
  const renderFloatingShapes = () => {
    return (
      <>
        <div className="floating-shape top-32 left-[8%] w-16 h-16 bg-green-500/10 dark:bg-green-500/20 rounded-full"></div>
        <div className="floating-shape top-48 right-[12%] w-20 h-20 bg-blue-500/10 dark:bg-blue-500/20 rounded-full" style={{ animationDelay: '1s' }}></div>
        <div className="floating-shape top-[60%] left-[15%] w-24 h-24 bg-purple-500/10 dark:bg-purple-500/20 rounded-full" style={{ animationDelay: '2s' }}></div>
        <div className="floating-shape bottom-32 right-[8%] w-28 h-28 bg-cyan-500/10 dark:bg-cyan-500/20 rounded-full" style={{ animationDelay: '1.5s' }}></div>
        <div className="floating-shape top-[25%] left-[35%] w-12 h-12 bg-pink-500/10 dark:bg-pink-500/20 rounded-full" style={{ animationDelay: '0.5s' }}></div>
        <div className="floating-shape top-[70%] right-[25%] w-18 h-18 bg-yellow-500/10 dark:bg-yellow-500/20 rounded-full" style={{ animationDelay: '2.5s' }}></div>
        <div className="floating-shape bottom-[60%] left-[5%] w-14 h-14 bg-red-500/10 dark:bg-red-500/20 rounded-full" style={{ animationDelay: '3s' }}></div>
      </>
    );
  };

  return (
    <div className="min-h-screen flex flex-col">
      <Header />
      
      {/* Login Reminder */}
      {showLoginReminder && (
        <div className="fixed top-20 right-4 bg-blue-600 text-white p-4 rounded-lg shadow-lg z-50 animate-slide-in-right max-w-sm">
          <div className="flex items-start space-x-3">
            <Info className="h-5 w-5 mt-0.5 flex-shrink-0" />
            <div>
              <h4 className="font-semibold">Login Required</h4>
              <p className="text-sm">For full functionality like saving progress and generating reports, please login to your account.</p>
              <div className="mt-2 flex space-x-2">
                <Button size="sm" variant="secondary" onClick={() => setShowLoginReminder(false)}>
                  Later
                </Button>
                <Button size="sm" variant="primary" onClick={() => navigate('/login')}>
                  Login Now
                </Button>
              </div>
            </div>
          </div>
        </div>
      )}
      
      {/* Hero Section with proper spacing and background animations */}
      <section className="relative pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
        {renderFloatingShapes()}
        
        <div className="container mx-auto px-4">
          {/* Header Section */}
          <div className="text-center mb-12">
            <h1 className="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6 animate-slide-in-up">
              Health <span className="bg-clip-text text-transparent bg-gradient-to-r from-green-500 to-blue-600">Dashboard</span>
            </h1>
            <p className="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto animate-slide-in-up" style={{ animationDelay: '0.1s' }}>
              Track your health, monitor progress, and achieve your wellness goals
            </p>
            {!isAuthenticated && (
              <div className="mt-6 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg max-w-2xl mx-auto animate-slide-in-up" style={{ animationDelay: '0.2s' }}>
                <div className="flex items-center justify-center space-x-2">
                  <AlertCircle className="h-5 w-5 text-yellow-600 dark:text-yellow-400" />
                  <p className="text-yellow-800 dark:text-yellow-200">
                    You're viewing in guest mode. Login to save your progress and access all features.
                  </p>
                </div>
              </div>
            )}
          </div>

          {/* Navigation Tabs */}
          <div className="flex flex-wrap justify-center mb-8 space-x-1 animate-slide-in-up" style={{ animationDelay: '0.3s' }}>
            {[
              { id: 'plans', label: 'Health Plans', icon: <Dumbbell size={18} /> },
              { id: 'dashboard', label: 'Dashboard', icon: <BarChart3 size={18} /> },
              { id: 'profile', label: 'Profile', icon: <User size={18} /> },
              { id: 'reports', label: 'Reports', icon: <FileText size={18} /> }
            ].map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id as any)}
                className={`
                  flex items-center space-x-2 px-4 py-2 rounded-lg font-medium transition-all duration-200
                  ${activeTab === tab.id 
                    ? 'bg-blue-600 text-white shadow-lg' 
                    : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
                  }
                `}
              >
                {tab.icon}
                <span>{tab.label}</span>
              </button>
            ))}
          </div>
        </div>
      </section>
      
      <main className="flex-1 pb-8">
        <div className="container mx-auto px-4">
          {/* Health Plans Tab - Now the main focus */}
          {activeTab === 'plans' && (
            <div className="animate-fade-in">
              <div className="text-center mb-8">
                <h2 className="text-3xl font-bold text-gray-900 dark:text-white mb-4">
                  Choose Your Health Journey
                </h2>
                <p className="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
                  Select a personalized health plan that matches your goals and lifestyle. Each plan includes daily activities, weekly goals, and progress tracking.
                </p>
              </div>
              
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {healthPlans.map((plan, index) => {
                  const progress = planProgress[plan.id] || 0;
                  const isActive = selectedPlan === plan.id || progress > 0;
                  
                  return (
                    <Card 
                      key={index} 
                      withHover 
                      withGlow={isActive}
                      className={`animate-fade-in ${isActive ? 'ring-2 ring-blue-500' : ''}`} 
                      style={{ animationDelay: `${index * 0.1}s` }}
                    >
                      <div className="text-center">
                        <div className="mb-4 relative">
                          {plan.icon}
                          {isActive && (
                            <div className="absolute -top-2 -right-2">
                              <CheckCircle className="h-6 w-6 text-green-500" />
                            </div>
                          )}
                        </div>
                        
                        <h3 className="text-xl font-bold text-gray-900 dark:text-white mb-2">
                          {plan.title}
                        </h3>
                        
                        <p className="text-gray-600 dark:text-gray-400 mb-4">
                          {plan.description}
                        </p>
                        
                        <div className="flex justify-between text-sm text-gray-500 dark:text-gray-400 mb-4">
                          <span>Duration: {plan.duration}</span>
                          <span>Level: {plan.difficulty}</span>
                        </div>
                        
                        {isActive && progress > 0 && (
                          <div className="mb-4">
                            <div className="flex justify-between text-sm mb-1">
                              <span>Progress</span>
                              <span>{progress}%</span>
                            </div>
                            <div className="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                              <div 
                                className="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                style={{ width: `${progress}%` }}
                              ></div>
                            </div>
                          </div>
                        )}
                        
                        <ul className="text-sm text-gray-600 dark:text-gray-400 mb-6 space-y-1">
                          {plan.features.map((feature, featureIndex) => (
                            <li key={featureIndex} className="flex items-center">
                              <div className={`w-1 h-1 bg-${plan.color}-500 rounded-full mr-2`}></div>
                              {feature}
                            </li>
                          ))}
                        </ul>
                        
                        <Button 
                          variant={isActive ? "success" : "primary"}
                          size="sm" 
                          className="w-full"
                          onClick={() => handleStartPlan(plan.id)}
                          icon={isActive ? <CheckCircle size={16} /> : <Play size={16} />}
                        >
                          {isActive ? 'Continue Plan' : 'Start Plan'}
                        </Button>
                        
                        {isActive && (
                          <div className="mt-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg">
                            <h4 className="font-semibold text-sm mb-2">Today's Activities:</h4>
                            <ul className="text-xs space-y-1">
                              {plan.dailyActivities.slice(0, 3).map((activity, i) => (
                                <li key={i} className="flex items-center">
                                  <div className="w-1 h-1 bg-green-500 rounded-full mr-2"></div>
                                  {activity}
                                </li>
                              ))}
                            </ul>
                            {isAuthenticated && (
                              <Button 
                                size="sm" 
                                variant="secondary" 
                                className="w-full mt-2"
                                onClick={() => updatePlanProgress(plan.id, Math.min(100, progress + 10))}
                              >
                                Mark Progress +10%
                              </Button>
                            )}
                          </div>
                        )}
                      </div>
                    </Card>
                  );
                })}
              </div>
              
              {/* Plan Details Section */}
              {selectedPlan && (
                <div className="mt-12">
                  <Card title="Your Active Plan Details" withHover className="animate-fade-in">
                    {(() => {
                      const plan = healthPlans.find(p => p.id === selectedPlan);
                      if (!plan) return null;
                      
                      return (
                        <div className="space-y-6">
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                              <h4 className="font-semibold text-lg mb-3">Daily Activities</h4>
                              <ul className="space-y-2">
                                {plan.dailyActivities.map((activity, index) => (
                                  <li key={index} className="flex items-center space-x-2">
                                    <Clock className="h-4 w-4 text-blue-500" />
                                    <span className="text-gray-700 dark:text-gray-300">{activity}</span>
                                  </li>
                                ))}
                              </ul>
                            </div>
                            
                            <div>
                              <h4 className="font-semibold text-lg mb-3">Weekly Goals</h4>
                              <ul className="space-y-2">
                                {plan.weeklyGoals.map((goal, index) => (
                                  <li key={index} className="flex items-center space-x-2">
                                    <Target className="h-4 w-4 text-green-500" />
                                    <span className="text-gray-700 dark:text-gray-300">{goal}</span>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          </div>
                          
                          {isAuthenticated && (
                            <div className="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4">
                              <h4 className="font-semibold text-blue-900 dark:text-blue-100 mb-2">
                                Progress Tracking
                              </h4>
                              <p className="text-blue-800 dark:text-blue-200 text-sm mb-3">
                                Track your daily progress and see how you're advancing towards your goals.
                              </p>
                              <div className="flex space-x-2">
                                <Button 
                                  size="sm" 
                                  variant="primary"
                                  onClick={() => updatePlanProgress(selectedPlan, Math.min(100, (planProgress[selectedPlan] || 0) + 10))}
                                >
                                  Complete Today's Tasks
                                </Button>
                                <Button 
                                  size="sm" 
                                  variant="secondary"
                                  onClick={() => setActiveTab('dashboard')}
                                >
                                  View Dashboard
                                </Button>
                              </div>
                            </div>
                          )}
                        </div>
                      );
                    })()}
                  </Card>
                </div>
              )}
            </div>
          )}

          {/* Dashboard Tab */}
          {activeTab === 'dashboard' && (
            <div className="space-y-8 animate-fade-in">
              {!isAuthenticated && (
                <Card className="bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800">
                  <div className="text-center">
                    <AlertCircle className="h-12 w-12 text-blue-600 dark:text-blue-400 mx-auto mb-4" />
                    <h3 className="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-2">
                      Login to View Your Dashboard
                    </h3>
                    <p className="text-blue-800 dark:text-blue-200 mb-4">
                      Create an account or login to access your personalized health dashboard with BMI calculator, water intake recommendations, and progress tracking.
                    </p>
                    <div className="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-4 justify-center">
                      <Button variant="primary" onClick={() => navigate('/login')}>
                        Login
                      </Button>
                      <Button variant="secondary" onClick={() => navigate('/register')}>
                        Create Account
                      </Button>
                    </div>
                  </div>
                </Card>
              )}
              
              {isAuthenticated && healthProfile && (
                <>
                  {/* Quick Stats */}
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <Card withHover withGlow>
                      <div className="flex items-center">
                        <div className="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center mr-4">
                          <Calculator className="h-6 w-6 text-blue-600 dark:text-blue-400" />
                        </div>
                        <div>
                          <p className="text-sm text-gray-600 dark:text-gray-400">BMI</p>
                          <p className="text-2xl font-bold text-gray-900 dark:text-white">{calculateBMI(healthProfile.height, healthProfile.weight).bmi}</p>
                          <p className={`text-xs ${
                            calculateBMI(healthProfile.height, healthProfile.weight).category === 'normal' ? 'text-green-600' :
                            calculateBMI(healthProfile.height, healthProfile.weight).category === 'overweight' ? 'text-yellow-600' :
                            'text-red-600'
                          }`}>
                            {calculateBMI(healthProfile.height, healthProfile.weight).category.toUpperCase()}
                          </p>
                        </div>
                      </div>
                    </Card>
                    
                    <Card withHover withGlow>
                      <div className="flex items-center">
                        <div className="w-12 h-12 rounded-full bg-cyan-100 dark:bg-cyan-900 flex items-center justify-center mr-4">
                          <Droplet className="h-6 w-6 text-cyan-600 dark:text-cyan-400" />
                        </div>
                        <div>
                          <p className="text-sm text-gray-600 dark:text-gray-400">Daily Water</p>
                          <p className="text-2xl font-bold text-gray-900 dark:text-white">{calculateWaterIntake(healthProfile.weight, healthProfile.activity_level, 25).daily_liters}L</p>
                          <p className="text-xs text-gray-500">{calculateWaterIntake(healthProfile.weight, healthProfile.activity_level, 25).glasses} glasses</p>
                        </div>
                      </div>
                    </Card>
                    
                    <Card withHover withGlow>
                      <div className="flex items-center">
                        <div className="w-12 h-12 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center mr-4">
                          <Activity className="h-6 w-6 text-green-600 dark:text-green-400" />
                        </div>
                        <div>
                          <p className="text-sm text-gray-600 dark:text-gray-400">Exercise</p>
                          <p className="text-2xl font-bold text-gray-900 dark:text-white">{calculateExerciseRecommendation(healthProfile.fitness_goal, healthProfile.activity_level).daily_minutes}m</p>
                          <p className="text-xs text-gray-500">daily</p>
                        </div>
                      </div>
                    </Card>
                    
                    <Card withHover withGlow>
                      <div className="flex items-center">
                        <div className="w-12 h-12 rounded-full bg-purple-100 dark:bg-purple-900 flex items-center justify-center mr-4">
                          <TrendingUp className="h-6 w-6 text-purple-600 dark:text-purple-400" />
                        </div>
                        <div>
                          <p className="text-sm text-gray-600 dark:text-gray-400">Active Plans</p>
                          <p className="text-2xl font-bold text-gray-900 dark:text-white">{Object.keys(planProgress).length}</p>
                          <p className="text-xs text-gray-500">in progress</p>
                        </div>
                      </div>
                    </Card>
                  </div>

                  {/* Detailed Information */}
                  <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <Card title="BMI Analysis" withHover>
                      <div className="space-y-4">
                        <div className="text-center">
                          <div className="text-4xl font-bold text-gray-900 dark:text-white mb-2">
                            {calculateBMI(healthProfile.height, healthProfile.weight).bmi}
                          </div>
                          <div className={`
                            px-3 py-1 rounded-full text-sm font-medium inline-block
                            ${calculateBMI(healthProfile.height, healthProfile.weight).category === 'normal' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
                              calculateBMI(healthProfile.height, healthProfile.weight).category === 'overweight' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
                              'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
                            }
                          `}>
                            {calculateBMI(healthProfile.height, healthProfile.weight).category.toUpperCase()}
                          </div>
                        </div>
                        <p className="text-gray-600 dark:text-gray-400 text-center">
                          {calculateBMI(healthProfile.height, healthProfile.weight).description}
                        </p>
                        <div className="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                          <div 
                            className={`h-2 rounded-full ${
                              calculateBMI(healthProfile.height, healthProfile.weight).category === 'normal' ? 'bg-green-500' :
                              calculateBMI(healthProfile.height, healthProfile.weight).category === 'overweight' ? 'bg-yellow-500' :
                              'bg-red-500'
                            }`}
                            style={{ width: `${Math.min((calculateBMI(healthProfile.height, healthProfile.weight).bmi || 0) / 30 * 100, 100)}%` }}
                          ></div>
                        </div>
                      </div>
                    </Card>
                    
                    <Card title="Active Health Plans" withHover>
                      <div className="space-y-4">
                        {Object.entries(planProgress).length === 0 ? (
                          <p className="text-gray-500 dark:text-gray-400 text-center py-8">
                            No active plans. Visit the Health Plans tab to get started!
                          </p>
                        ) : (
                          Object.entries(planProgress).map(([planId, progress]) => {
                            const plan = healthPlans.find(p => p.id === planId);
                            if (!plan) return null;
                            
                            return (
                              <div key={planId} className="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                                <div className="flex items-center justify-between mb-2">
                                  <h4 className="font-semibold text-gray-900 dark:text-white">{plan.title}</h4>
                                  <span className="text-sm text-gray-500">{progress}%</span>
                                </div>
                                <div className="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 mb-2">
                                  <div 
                                    className="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                    style={{ width: `${progress}%` }}
                                  ></div>
                                </div>
                                <p className="text-sm text-gray-600 dark:text-gray-400">{plan.description}</p>
                              </div>
                            );
                          })
                        )}
                      </div>
                    </Card>
                  </div>
                </>
              )}
            </div>
          )}

          {/* Profile Tab */}
          {activeTab === 'profile' && (
            <div className="max-w-4xl mx-auto animate-fade-in">
              {!isAuthenticated ? (
                <Card className="bg-yellow-50 dark:bg-yellow-900/20 border-yellow-200 dark:border-yellow-800">
                  <div className="text-center">
                    <User className="h-12 w-12 text-yellow-600 dark:text-yellow-400 mx-auto mb-4" />
                    <h3 className="text-lg font-semibold text-yellow-900 dark:text-yellow-100 mb-2">
                      Create Your Health Profile
                    </h3>
                    <p className="text-yellow-800 dark:text-yellow-200 mb-4">
                      Login to create and manage your personalized health profile with BMI tracking, goals, and more.
                    </p>
                    <div className="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-4 justify-center">
                      <Button variant="primary" onClick={() => navigate('/login')}>
                        Login to Continue
                      </Button>
                      <Button variant="secondary" onClick={() => navigate('/register')}>
                        Create Account
                      </Button>
                    </div>
                  </div>
                </Card>
              ) : (
                <>
                  {(isFirstTime || isEditing) && (
                    <Card title={isFirstTime ? "Create Your Health Profile" : "Edit Health Profile"} className="animate-fade-in">
                      <form onSubmit={handleSubmit} className="space-y-6">
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                          <Input
                            label="Height (cm)"
                            type="number"
                            value={formData.height}
                            onChange={(e) => setFormData({...formData, height: e.target.value})}
                            error={errors.height}
                            leftIcon={<User size={18} />}
                            placeholder="175"
                          />
                          
                          <Input
                            label="Weight (kg)"
                            type="number"
                            value={formData.weight}
                            onChange={(e) => setFormData({...formData, weight: e.target.value})}
                            error={errors.weight}
                            leftIcon={<Scale size={18} />}
                            placeholder="70"
                          />
                          
                          <div>
                            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Gender</label>
                            <select
                              value={formData.gender}
                              onChange={(e) => setFormData({...formData, gender: e.target.value as any})}
                              className="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-2 text-gray-900 dark:text-gray-200"
                            >
                              <option value="male">Male</option>
                              <option value="female">Female</option>
                              <option value="other">Other</option>
                            </select>
                          </div>
                          
                          <Input
                            label="Blood Type"
                            value={formData.blood_type}
                            onChange={(e) => setFormData({...formData, blood_type: e.target.value})}
                            error={errors.blood_type}
                            leftIcon={<Heart size={18} />}
                            placeholder="O+"
                          />
                          
                          <div>
                            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Fitness Goal</label>
                            <select
                              value={formData.fitness_goal}
                              onChange={(e) => setFormData({...formData, fitness_goal: e.target.value as any})}
                              className="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-2 text-gray-900 dark:text-gray-200"
                            >
                              <option value="general_health">General Health</option>
                              <option value="weight_loss">Weight Loss</option>
                              <option value="muscle_gain">Muscle Gain</option>
                              <option value="custom">Custom</option>
                            </select>
                          </div>
                          
                          <Input
                            label="Target Weight (kg)"
                            type="number"
                            value={formData.target_weight}
                            onChange={(e) => setFormData({...formData, target_weight: e.target.value})}
                            error={errors.target_weight}
                            leftIcon={<Target size={18} />}
                            placeholder="65"
                          />
                          
                          <div>
                            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Activity Level</label>
                            <select
                              value={formData.activity_level}
                              onChange={(e) => setFormData({...formData, activity_level: e.target.value as any})}
                              className="w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-2 text-gray-900 dark:text-gray-200"
                            >
                              <option value="sedentary">Sedentary</option>
                              <option value="light">Light</option>
                              <option value="moderate">Moderate</option>
                              <option value="active">Active</option>
                              <option value="very_active">Very Active</option>
                            </select>
                          </div>
                        </div>
                        
                        <div className="space-y-4">
                          <Input
                            label="Chronic Diseases (if any)"
                            value={formData.chronic_diseases}
                            onChange={(e) => setFormData({...formData, chronic_diseases: e.target.value})}
                            placeholder="None or specify conditions"
                          />
                          
                          <Input
                            label="Allergies (if any)"
                            value={formData.allergies}
                            onChange={(e) => setFormData({...formData, allergies: e.target.value})}
                            placeholder="None or specify allergies"
                          />
                          
                          <Input
                            label="Dietary Preferences"
                            value={formData.dietary_preferences}
                            onChange={(e) => setFormData({...formData, dietary_preferences: e.target.value})}
                            placeholder="e.g., Vegetarian, Vegan, Gluten-free"
                          />
                        </div>
                        
                        <div className="flex space-x-4 pt-4">
                          <Button
                            type="submit"
                            variant="success"
                            isLoading={isLoading}
                            icon={<Save size={18} />}
                          >
                            {isFirstTime ? 'Create Profile' : 'Save Changes'}
                          </Button>
                          
                          {!isFirstTime && (
                            <Button
                              type="button"
                              variant="secondary"
                              onClick={() => setIsEditing(false)}
                            >
                              Cancel
                            </Button>
                          )}
                        </div>
                      </form>
                    </Card>
                  )}

                  {!isFirstTime && !isEditing && healthProfile && (
                    <Card 
                      title="Health Profile" 
                      headerAction={
                        <Button 
                          variant="primary" 
                          size="sm" 
                          icon={<Edit size={16} />}
                          onClick={handleEdit}
                        >
                          Edit Profile
                        </Button>
                      }
                      withHover
                    >
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div className="space-y-4">
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Height</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.height} cm</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Weight</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.weight} kg</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Gender</p>
                            <p className="text-lg text-gray-900 dark:text-white capitalize">{healthProfile.gender}</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Blood Type</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.blood_type}</p>
                          </div>
                        </div>
                        
                        <div className="space-y-4">
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Fitness Goal</p>
                            <p className="text-lg text-gray-900 dark:text-white capitalize">
                              {healthProfile.fitness_goal.replace('_', ' ')}
                            </p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Target Weight</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.target_weight} kg</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Activity Level</p>
                            <p className="text-lg text-gray-900 dark:text-white capitalize">
                              {healthProfile.activity_level.replace('_', ' ')}
                            </p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Dietary Preferences</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.dietary_preferences}</p>
                          </div>
                        </div>
                        
                        <div className="md:col-span-2 space-y-4">
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Chronic Diseases</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.chronic_diseases}</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-500 dark:text-gray-400">Allergies</p>
                            <p className="text-lg text-gray-900 dark:text-white">{healthProfile.allergies}</p>
                          </div>
                        </div>
                      </div>
                    </Card>
                  )}
                </>
              )}
            </div>
          )}

          {/* Reports Tab */}
          {activeTab === 'reports' && (
            <div className="max-w-4xl mx-auto animate-fade-in">
              <Card title="Generate Health Reports" withHover>
                <div className="space-y-6">
                  <p className="text-gray-600 dark:text-gray-400">
                    Generate comprehensive reports about your health progress and statistics.
                  </p>
                  
                  {!isAuthenticated && (
                    <div className="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-lg p-4">
                      <div className="flex items-center space-x-2">
                        <AlertCircle className="h-5 w-5 text-orange-600 dark:text-orange-400" />
                        <p className="text-orange-800 dark:text-orange-200">
                          Login required to generate and download personalized health reports.
                        </p>
                      </div>
                    </div>
                  )}
                  
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {[
                      { period: 'daily', label: 'Daily Report', desc: 'Yesterday\'s health data and progress' },
                      { period: 'weekly', label: 'Weekly Report', desc: 'Last 7 days summary and trends' },
                      { period: 'monthly', label: 'Monthly Report', desc: 'Complete month analysis and insights' },
                      { period: 'yearly', label: 'Yearly Report', desc: 'Annual health overview and achievements' }
                    ].map((report) => (
                      <div key={report.period} className="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                        <h4 className="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                          {report.label}
                        </h4>
                        <p className="text-gray-600 dark:text-gray-400 mb-4">
                          {report.desc}
                        </p>
                        <div className="flex space-x-2">
                          <Button
                            variant="primary"
                            size="sm"
                            onClick={() => generateReport(report.period as any, 'pdf')}
                            isLoading={isLoading}
                            icon={<Download size={16} />}
                            disabled={!isAuthenticated}
                          >
                            PDF
                          </Button>
                          <Button
                            variant="success"
                            size="sm"
                            onClick={() => generateReport(report.period as any, 'excel')}
                            isLoading={isLoading}
                            icon={<Download size={16} />}
                            disabled={!isAuthenticated}
                          >
                            Excel
                          </Button>
                        </div>
                      </div>
                    ))}
                  </div>
                  
                  <div className="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4">
                    <h4 className="text-lg font-semibold text-blue-900 dark:text-blue-100 mb-2">
                      Report Contents
                    </h4>
                    <ul className="text-sm text-blue-800 dark:text-blue-200 space-y-1">
                      <li>• Personal health profile and basic information</li>
                      <li>• BMI calculations and category analysis</li>
                      <li>• Water intake recommendations and tracking</li>
                      <li>• Exercise recommendations and completion rates</li>
                      <li>• Health goals progress and achievements</li>
                      <li>• Daily health data trends and patterns</li>
                      <li>• Comparative analysis with previous periods</li>
                      <li>• Personalized insights and recommendations</li>
                    </ul>
                  </div>
                </div>
              </Card>
            </div>
          )}
        </div>
      </main>
      
      <Footer />
    </div>
  );
};

export default Health; 